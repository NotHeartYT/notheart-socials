<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Name | Personal Hub</title>

    <link rel="stylesheet" href="style.css">

    <!-- Google Font (Inter) -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

<main class="container">

    <!-- ================= PROFILE ================= -->
    <header class="profile">
        <img src="avatar.png" alt="Profile Picture" class="avatar">
        <h1>Your Name</h1>
        <p>Content Creator • Developer • Gamer</p>
    </header>

    <!-- ================= SOCIAL LINKS ================= -->
    <nav class="links" aria-label="Social Links Menu">
        
        <a href="https://youtube.com" 
           class="link-btn" 
           target="_blank" 
           rel="noopener noreferrer">
            <span>YouTube</span>
        </a>

        <a href="https://discord.gg" 
           class="link-btn" 
           target="_blank" 
           rel="noopener noreferrer">
            <span>Discord</span>
        </a>

        <a href="#" 
           class="link-btn" 
           target="_blank" 
           rel="noopener noreferrer">
            <span>GitHub</span>
        </a>
        
    </nav>

    <!-- ================= DISCORD BENTO CARD ================= -->
    <section class="discord">
        <div class="discord-card">
            <h2>Join the Community</h2>
            <p>Chat with the community, receive updates, and participate in events.</p>
            <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" class="discord-btn">
                Join Discord
            </a>
        </div>
    </section>

    <!-- ================= YOUTUBE FEATURED CARD ================= -->
    <section class="youtube">
        <a href="https://youtube.com" 
           target="_blank" 
           rel="noopener noreferrer" 
           class="yt-button">
            Visit My YouTube
        </a>
    </section>

</main>

</body>
</html>
